Options -Indexes

<Files "deploy.php">
    Order allow,deny
    Allow from all
</Files>

# Scripts de banco não devem ser baixáveis pela web — eles expõem o esquema
# completo do sistema e, em alguns casos, hashes de senha. Ficam versionados
# aqui só para serem executados no phpMyAdmin, nunca pelo navegador.
# Esta regra vale para esta pasta e todas as subpastas, cobrindo tanto os
# .sql soltos na raiz quanto database/migrations/. Os .md (LEIA-ME de cada
# instância) trazem instruções internas e senhas temporárias — também fora da web.
<FilesMatch "\.(sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

